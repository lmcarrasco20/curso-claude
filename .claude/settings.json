{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bloquear-borrado-bd.js",
            "statusMessage": "Comprobando borrado de vendehumos.db..."
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bloquear-lectura-constants.js",
            "statusMessage": "Comprobando lectura de CONSTANTS.js..."
          }
        ]
      }
    ]
  }
}
